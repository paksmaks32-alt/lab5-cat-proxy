{
  "info": {
    "_postman_id": "ee57d6d0-a6db-44cb-99c5-8c21633ee39b",
    "name": "ЛР5 Кешуючий проксі http.cat",
    "description": "Перевірка методів GET, PUT, DELETE і помилок. Перед запуском очистити теку cache.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "60101176",
    "_collection_link": "https://go.postman.co/collection/60101176-ee57d6d0-a6db-44cb-99c5-8c21633ee39b?source=collection_link"
  },
  "item": [
    {
      "name": "1. GET картинки, якої немає в кеші",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Код стану 200 OK', () => pm.response.to.have.status(200));",
              "pm.test('Content-Type: image/jpeg', () => pm.expect(pm.response.headers.get('Content-Type')).to.eql('image/jpeg'));",
              "pm.test('X-Cache-Source: http.cat', () => pm.expect(pm.response.headers.get('X-Cache-Source')).to.eql('http.cat'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/418",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "418"
          ]
        },
        "description": "Промах кешу: сервер бере картинку з http.cat і зберігає її в кеш."
      },
      "response": []
    },
    {
